{
  "manifest_version": 3,
  "name": "YouTube Subtitle Companion",
  "version": "0.1.0",
  "description": "Reads YouTube subtitles and forwards them to the desktop overlay app.",
  "host_permissions": ["https://www.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-bridge.js"],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}
