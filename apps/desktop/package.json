{
  "name": "@youtube-subtitle-companion/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "build:app": "node ./scripts/build.mjs",
    "build": "pnpm run build:app && electron-builder --config electron-builder.yml",
    "build:linux": "pnpm run build:app && electron-builder --config electron-builder.yml --linux AppImage",
    "build:win": "pnpm run build:app && electron-builder --config electron-builder.yml --win nsis"
  },
  "dependencies": {
    "@youtube-subtitle-companion/shared": "workspace:*",
    "electron-store": "^10.0.1",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  }
}
